# ─── DATABASE ─────────────────────────────────────────────
ASYNC_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/dbname

# ─── REDIS CACHE ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_DEFAULT=3600
ENABLE_EMOTION_CACHE=true

# ─── JWT AUTHENTICATION ──────────────────────────────────
JWT_SECRET=replace_this_with_a_secure_random_secret
ENABLE_AUTH=true

# ─── MONITORING ───────────────────────────────────────────
ENABLE_METRICS=true
LOG_LEVEL=info

# ─── SYMBOLIC ENGINE (ZMQ) ────────────────────────────────
ZMQ_ADDRESS=tcp://localhost:5555
ZMQ_TIMEOUT_MS=3000
ZMQ_POOL_SIZE=4
ENABLE_SYMBOLIC_FALLBACK=true

# ─── LLM CONFIGURATION ────────────────────────────────────
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4
ENABLE_DYNAMIC_PROMPTS=true

# ─── API SERVER ───────────────────────────────────────────
API_PORT=5101
ENABLE_PROMPT_DEBUG=true

# ─── FEATURE FLAGS ────────────────────────────────────────
ENABLE_RECOVERY=true
