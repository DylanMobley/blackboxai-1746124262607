# ─────────────────────────────────────
# 🌐 API Services
# ─────────────────────────────────────
VITE_API_URL=https://api.empathyethicist.ai
VITE_CLONE_API=https://clone.empathyethicist.ai
VITE_TTS_API_URL=http://localhost:5111

# ─────────────────────────────────────
# 🔐 Security (Frontend Flags Only)
# ─────────────────────────────────────
VITE_REQUIRE_AUTH=true
VITE_AUTH_TOKEN_KEY=mec_auth_token

# ─────────────────────────────────────
# 📏 Input Constraints
# ─────────────────────────────────────
VITE_MAX_TEXT_LENGTH=500
VITE_MAX_AUDIO_MB=10
VITE_MAX_IMAGE_MB=5

# ─────────────────────────────────────
# 🧠 Emotion Freedom Mode (No Hard Limits)
# ─────────────────────────────────────

# ─────────────────────────────────────
# 🧪 Feature Flags
# ─────────────────────────────────────
VITE_ENABLE_AUTO_TTS=true
VITE_ENABLE_MIC=true
VITE_ENABLE_METRICS=true

# ─────────────────────────────────────
# 📊 Monitoring Services
# ─────────────────────────────────────
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_GRAFANA_URL=http://localhost:3000
