# ─────────────────────────────────────
# 🌐 API CONFIGURATION
# ─────────────────────────────────────
FLASK_ENV=production
PORT=5101
CLONE_API_PORT=5105

# ─────────────────────────────────────
# 🔐 AUTH + SECURITY
# ─────────────────────────────────────
CLONE_API_KEY=supersecurekey
JWT_SECRET=changeme-super-secret
ALLOWED_ORIGINS=https://www.empathyethicist.ai,https://api.empathyethicist.ai,http://localhost:5173

# ─────────────────────────────────────
# 📏 INPUT LIMITS
# ─────────────────────────────────────
MAX_TEXT_LENGTH=500
MAX_AUDIO_MB=10
MAX_IMAGE_MB=5
ALLOWED_EMOTIONS=[neutral],[happy],[sad],[angry],[guilt],[fear],[cheerful],[emotional],[soothing],[reassuring],[empathetic]

# ─────────────────────────────────────
# 🧼 FILE RETENTION (in hours)
# ─────────────────────────────────────
AUDIO_RETENTION_HOURS=12
VIDEO_RETENTION_HOURS=12

# ─────────────────────────────────────
# 🧪 FEATURE FLAGS
# ─────────────────────────────────────
ENABLE_AUTH=true
ENABLE_USER_QUOTAS=false
ENABLE_CLONE_LOGS=true
ENABLE_RATE_LIMITER=true
ENABLE_EMOTION_FILTER=false

# ─────────────────────────────────────
# ⚙️ CELERY / REDIS / BROKERS
# ─────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────
# 🧠 PRETRAINED MODELS
# ─────────────────────────────────────
EMOTION_MODEL_PATH=pretrained/emotion/model
EMPATHY_MODEL_PATH=pretrained/empathy-llm
RECOVERY_MODEL_PATH=pretrained/recovery-model

# ─────────────────────────────────────
# 🚀 FRONTEND INTEGRATION
# ─────────────────────────────────────
VITE_API_URL=https://api.empathyethicist.ai
VITE_CLONE_API=https://clone.empathyethicist.ai
